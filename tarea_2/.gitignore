# --- Datos originales, cachés, referencias y material privado (no se versionan) ---
datos/raw/
# incluye datos/raw/privacidad/ (mapas nombre -> marcador, tabla de redacción,
# respaldos previos a la publicación y respaldo del historial git original)
datos/raw/privacidad/

# --- Imágenes originales fuera de datos/raw/ (protección adicional) ---
datos/**/*.jpg
datos/**/*.jpeg
datos/**/*.png
datos/**/*.tif
datos/**/*.tiff
datos/**/*.JPG
datos/**/*.PNG

# --- Modelos: toda la carpeta (pesos, checkpoints, tessdata, ONNX, cachés) ---
modelos/
modelos/*.safetensors
modelos/*.bin
modelos/*.pt
modelos/*.pth
modelos/*.onnx
modelos/*.pdparams
modelos/*.gguf
modelos/checkpoint-*/
.cache/
.paddlex/
huggingface/

# --- Python / Jupyter ---
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- Entornos y secretos (nunca subir claves ni tokens) ---
.env
.env.*
.venv/
venv/
.streamlit/secrets.toml
*.key
*.pem

# --- Sistema ---
Thumbs.db
desktop.ini
.DS_Store

# --- Archivos privados de revisión (texto sin seudonimizar) ---
datos/REVISION_RAPIDA_REFERENCIAS.md
